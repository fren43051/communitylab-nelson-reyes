      "parameters": {
        "jsCode": "const entradas = $input.all();\n\nreturn {\n  json: {\n    schema_version: \"1.0.0\",\n    origen_comunidad: \"linkedin\",\n    periodo_referencia: new Date().toISOString().slice(0, 10),\n    interacciones: entradas\n      .map((item, index) => {\n        const dato = item.json.body ?? item.json;\n        const texto = dato.comment ?? dato.text ?? dato.mensaje ?? dato.texto ?? \"\";\n        return {\n          id: dato.id ?? `linkedin-${Date.now()}-${index}`,\n          autor: dato.authorName ?? dato.author ?? dato.autor ?? \"Anónimo\",\n          canal: \"linkedin\",\n          tipo: \"sin_clasificar\",\n          texto: texto,\n          metadata_origen: {\n            plataforma: \"linkedin\"\n          },\n          identificador_original: dato.id ?? null,\n          fecha: dato.createdAt ?? new Date().toISOString()\n        };\n      })\n      .filter((interaccion) => interaccion.texto.trim().length > 0)\n  }\n};"
      },
